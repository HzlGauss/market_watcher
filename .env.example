# ============================================
# 盯盘雷达 环境变量配置文件
# 使用前请填写以下密钥信息
# ============================================

# DeepSeek API 密钥（必填，用于AI研判分析）
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=你的DeepSeek_API_Key

# Server酱 SendKey（必填，用于微信推送）
# 获取地址: https://sct.ftqq.com  (GitHub登录后获取)
SCT_SENDKEY=你的Server酱_SendKey

# 东方财富妙想 API Key（选填，用于基金深度数据查询）
# 获取地址: https://dl.dfcfs.com/m/itc4  (登录妙想Skills页面获取)
MX_APIKEY=你的妙想API_Key

# ============================================
# 自定义LLM服务器配置（选填）
# ============================================

# 自定义LLM服务器基础URL
# 如果使用本地或私有部署的大模型（如Ollama、LM Studio等），请设置此变量
# 示例: LLM_BASE_URL=https://192.168.3.211:18443/v1
LLM_BASE_URL=

# 是否验证SSL证书（true/false）
# 如果您的自定义LLM服务器使用自签名证书或内部CA证书，设置为false跳过验证
# 注意：仅在信任的网络环境中使用false
LLM_VERIFY_SSL=true
